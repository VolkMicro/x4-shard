<?xml version="1.0" encoding="utf-8"?>
<diff>
  <!-- Clean universe: the map (sectors, gates, highways, asteroid fields) without NPC ships, stations or traffic.
       Everything alive is created by the mod on the server's word. Location and ship follow the stock test_smallship
       start (Argon Prime), facing +z so that "ahead" is simple in sector coordinates. -->
  <add sel="/gamestarts">
    <gamestart id="x4shard" name="X4 Shard" description="Shard client: clean universe, the world and other players come from the server." image="gamestart_custom_01" group="1">
      <!-- Second Contact II Flashpoint: a high-yield ore field (cylinder r 2.5 km) sits at the sector centre;
           the start is 7 km south of it, facing it (+z). Argon Prime has only decorative "nores" asteroids. -->
      <location galaxy="xu_ep2_universe_macro" sector="cluster_13_sector001_macro">
        <position x="0" y="0" z="-7000"/>
        <rotation yaw="0" pitch="0" roll="0"/>
      </location>
      <player macro="character_player_tutorial_macro" money="10000">
        <!-- the stock mining tutorial's ship and loadout (S miner with a mining laser) -->
        <ship macro="ship_arg_s_miner_solid_01_a_macro">
          <loadout ref="flightschool_player_ship_mining" />
        </ship>
      </player>
      <universe seed="20261102" ventures="false" visitors="false" onlineinventory="false">
        <jobs enabled="false" />
        <god enabled="false" />
        <masstraffic enabled="false" />
      </universe>
    </gamestart>
  </add>
</diff>
